{
  "name": "interviewforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "tsx watch backend/src/server.ts",
    "build": "pnpm build:backend && vite build --config frontend/vite.config.ts",
    "build:backend": "tsc -p tsconfig.backend.json",
    "start": "node dist/backend/src/server.js",
    "seed": "tsx backend/src/seed.ts",
    "typecheck": "tsc --noEmit && tsc -p frontend/tsconfig.json",
    "lint": "eslint backend frontend shared tests scripts",
    "test": "vitest run",
    "test:unit": "vitest run tests/backend",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "6.43.15",
    "@fastify/static": "^8.3.0",
    "better-sqlite3": "^12.4.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.18",
    "fastify": "^5.6.2",
    "marked": "^16.4.2",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "^3.35.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "~0.28.2",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.8",
    "vitest": "^3.2.4"
  }
}
